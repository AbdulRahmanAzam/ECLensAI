# Web environment — copy to apps/web/.env.local and adjust.
# Both values are optional; these are the defaults the app already uses.

# API prefix. In dev, leave this unset so requests stay same-origin and
# vite.config.ts proxies /api to the Express server on :4000 — that keeps the
# httpOnly session cookie working with no CORS configuration.
# Only set it when the API is served from a different origin, and then it must
# include the /api/v1 prefix, e.g. https://api.example.com/api/v1
# VITE_API_BASE=/api/v1

# ISO 4217 currency code shown across the app. Seeded default is PKR.
VITE_CURRENCY=PKR
