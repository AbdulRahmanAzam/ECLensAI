# API environment — copy to apps/api/.env and adjust. Never commit real values.
NODE_ENV=development
PORT=4000

# SQLite — a single file at apps/api/prisma/dev.db. No server to start, no
# docker compose, nothing to provision before a demo. `npm run db:up`/`db:down`
# still exist for the PostgreSQL path (see prisma-postgres-backup/ to switch back).
DATABASE_URL=file:./dev.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-real-deployments
JWT_EXPIRES_IN=12h
COOKIE_SECURE=false

# CORS — origin of the web app
CORS_ORIGIN=http://localhost:5173

# Rate limiting (foundation)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

LOG_LEVEL=info

# --- Guided Demo (Step 4) --------------------------------------------------
# Gates POST /api/v1/demo/reset (ADMIN-only, whole-database wipe-and-reseed).
# Set to false for any deployment that is not a disposable demo instance.
DEMO_MODE=true

# --- Gemini AI copilot (Step 3) -------------------------------------------
# Server-only. This key must never appear in a Vite variable, an API response,
# a log line or a client bundle. Leave it unset and the whole AI surface answers
# with an honest AI_UNAVAILABLE state; nothing else in the product is affected.
#
#   GEMINI_API_KEY=            # no default; unset means "AI unavailable"
#
AI_ENABLED=true
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Retrieval over uploaded governance documents and the seeded guidance library.
#   bm25      - scored in application code over a SQL-prefiltered candidate set;
#               needs no database extension and no API key. The offline default.
#   embedding - stores Gemini vectors on each chunk and ranks by cosine
#               similarity; needs GEMINI_API_KEY and GEMINI_EMBEDDING_MODEL.
GEMINI_RETRIEVAL_PROVIDER=bm25

# Request shaping and budgets
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_MAX_TOOL_ROUNDS=4
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARS=8000
AI_MAX_EVIDENCE_CHARS=24000

# AI-specific rate limit, keyed per signed-in user and shared by both AI routers.
# A refusal here is a real HTTP 429, unlike a declined answer, which is a 200.
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# Rough per-1k-token price in micro-USD. Used only for cost telemetry.
AI_COST_MICRO_PER_1K_INPUT=75
AI_COST_MICRO_PER_1K_OUTPUT=300

# What leaves the process. `redact` replaces borrower names with pseudonyms,
# `pseudonymize` keeps a stable per-request alias, `none` is only appropriate for
# a deployment whose data is already de-identified.
AI_REDACTION_PROFILE=redact

# Document upload limit and chunk size for retrieval
DOCUMENT_AI_MAX_BYTES=10485760
DOCUMENT_AI_CHUNK_CHARS=1800
