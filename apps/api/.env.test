# Test environment for the apps/api suite — loaded by test/setup-env.ts.
#
# The datasource provider is `postgresql`, so this has to be a PostgreSQL URL
# pointing at a throwaway database — a separate Neon branch, or a local
# `eclens_test` database — never the one the development server uses. The name
# must contain 'test'; scripts/prepare-test-db.mjs refuses anything else.
#
# The suite MUST NOT run against the development book. Audit events are
# append-only by design — there is no delete route — so a test run against the
# demo database leaves permanent residue in the audit log an auditor is meant to
# trust. Pinning the database here also means the tests can never reach a
# developer's own dev.db, whatever a developer's own .env says.
#
# Create and seed it with:  npm run db:test:prepare
DATABASE_URL=postgresql://eclens:eclens_local_dev@localhost:5433/eclens_test
NODE_ENV=test
